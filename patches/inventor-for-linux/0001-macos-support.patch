 if [ -z "${INV_FONT_DIRS+x}" ]; then
-    INV_FONT_DIRS=(/usr/share/fonts /usr/local/share/fonts "$HOME/.local/share/fonts" "$HOME/.fonts" "$WINE_DATA_DIR")
+    INV_FONT_DIRS=(/usr/share/fonts /usr/local/share/fonts "$HOME/.local/share/fonts" "$HOME/.fonts" "$HOME/Library/Fonts" /System/Library/Fonts /Library/Fonts "$WINE_DATA_DIR")
