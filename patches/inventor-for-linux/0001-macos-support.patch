diff --git a/mac-env.sh b/mac-env.sh
new file mode 100644
index 0000000..2b00794
--- /dev/null
+++ b/mac-env.sh
@@ -0,0 +1,14 @@
+# Source this before running any script of this project on macOS.
+B=/opt/homebrew
+export PATH="$B/opt/coreutils/libexec/gnubin:$B/opt/gnu-sed/libexec/gnubin:$B/opt/findutils/libexec/gnubin:$B/opt/grep/libexec/gnubin:$B/opt/gawk/libexec/gnubin:$B/opt/util-linux/bin:$B/opt/gnu-getopt/bin:$B/bin:$PATH"
+export INV_DISTRO=arch
+export INV_WINE=bundled
+export INV_WINE_HOME="$HOME/inventor-mac/wine"
+export INV_DXVK=dxmt
+export DXMT_DIR="$HOME/inventor-mac/dl/dxmt/v0.80"
+export INV_VKD3D=off
+export INV_YEAR=2027
+export INV_FONT_DIRS_MAC=1
+# Wine on macOS: Rosetta, no esync/msync surprises, Retina
+export WINEDEBUG="${WINEDEBUG:--all}"
+export WINEESYNC=0
diff --git a/scripts/install-from-image.py b/scripts/install-from-image.py
index 8ee39d1..7649f8f 100755
--- a/scripts/install-from-image.py
+++ b/scripts/install-from-image.py
@@ -1300,7 +1300,16 @@ class Installer:
         """Windows image names (lower case) of the processes running in this
         prefix, from /proc: WINEPREFIX in their environment, the Windows
         path as the first word of their command line."""
-        names, want = [], ("WINEPREFIX=" + self.prefix).encode()
+        names = []
+        if not os.path.isdir("/proc"):
+            # macOS: Wine sets each process's argv to its Windows command line
+            out = subprocess.run(["ps", "-axww", "-o", "command="], capture_output=True, text=True).stdout
+            for line in out.splitlines():
+                m = re.match(r'\s*"?([A-Za-z]:\\[^"]*?\.exe)', line, re.I)
+                if m:
+                    names.append(m.group(1).rsplit("\\", 1)[-1].lower())
+            return names
+        want = ("WINEPREFIX=" + self.prefix).encode()
         for pid in os.listdir("/proc"):
             if not pid.isdigit():
                 continue
