+/* Native macOS folder panel (winemac.drv); NULL + *used = FALSE means use Wine's dialog */
+static LPITEMIDLIST mac_browse_for_folder(LPBROWSEINFOW lpbi, BOOL *used)
+{
+    mac_file_panel_func panel_func = get_mac_file_panel();
+    struct mac_file_panel panel = {0};
+    WCHAR result[MAX_PATH + 2], *name;
+    LPITEMIDLIST pidl = NULL;
+    int ret;
+
+    *used = FALSE;
+    if (!panel_func || (lpbi->ulFlags & (BIF_BROWSEFORCOMPUTER | BIF_BROWSEFORPRINTER | BIF_BROWSEINCLUDEFILES)))
+        return NULL;
+    panel.mode = MAC_FILEPANEL_FOLDER;
+    panel.owner = lpbi->hwndOwner;
+    panel.title = lpbi->lpszTitle;
+    panel.results = result;
+    panel.results_size = ARRAY_SIZE(result);
+    if ((ret = panel_func(&panel)) < 0) return NULL;
+    *used = TRUE;
+    if (ret == 0) return NULL;
+    if (FAILED(SHParseDisplayName(result, NULL, &pidl, 0, NULL))) return NULL;
+    if (lpbi->pszDisplayName)
+    {
+        name = wcsrchr(result, '\\');
+        lstrcpynW(lpbi->pszDisplayName, name && name[1] ? name + 1 : result, MAX_PATH);
+    }
+    return pidl;
+}
