diff --git a/include/wine/mac_filepanel.h b/include/wine/mac_filepanel.h
new file mode 100644
index 0000000..e7a4020
--- /dev/null
+++ b/include/wine/mac_filepanel.h
@@ -0,0 +1,57 @@
+/*
+ * Native macOS file panels for Wine's file dialogs (winemac.drv export).
+ *
+ * comdlg32 / shell32 look up "wine_macdrv_file_panel" in winemac.drv; when it is
+ * there (and HKCU\Software\Wine\Mac Driver\NativeFileDialogs isn't "n") they show
+ * an NSOpenPanel/NSSavePanel instead of Wine's own dialog.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#ifndef __WINE_MAC_FILEPANEL_H
+#define __WINE_MAC_FILEPANEL_H
+
+#include "winreg.h"
+
+#define MAC_FILEPANEL_OPEN    0
+#define MAC_FILEPANEL_SAVE    1
+#define MAC_FILEPANEL_FOLDER  2
+
+struct mac_file_panel
+{
+    UINT          mode;           /* MAC_FILEPANEL_* */
+    UINT          multi;          /* allow multiple selection (open) */
+    HWND          owner;
+    const WCHAR  *title;          /* may be NULL */
+    const WCHAR  *ok_label;       /* may be NULL */
+    const WCHAR  *initial_dir;    /* DOS path, may be NULL */
+    const WCHAR  *file_name;      /* save: proposed name, may be NULL */
+    UINT          filter_count;
+    const WCHAR *const *filter_names;   /* "Inventor Part (*.ipt)" */
+    const WCHAR *const *filter_specs;   /* "*.ipt;*.iam" */
+    UINT          filter_index;   /* in/out, 0-based */
+    WCHAR        *results;        /* out: DOS paths, each NUL-terminated, list ends with an extra NUL */
+    UINT          results_size;   /* in WCHARs */
+};
+
+/* returns 1 = chosen, 0 = cancelled, -1 = not available (use Wine's dialog) */
+typedef int (CDECL *mac_file_panel_func)(struct mac_file_panel *panel);
+
+static inline mac_file_panel_func get_mac_file_panel(void)
+{
+    static const WCHAR keyW[] = {'S','o','f','t','w','a','r','e','\\','W','i','n','e','\\','M','a','c',' ','D','r','i','v','e','r',0};
+    static const WCHAR valueW[] = {'N','a','t','i','v','e','F','i','l','e','D','i','a','l','o','g','s',0};
+    static const WCHAR drvW[] = {'w','i','n','e','m','a','c','.','d','r','v',0};
+    WCHAR buf[8] = {0};
+    DWORD size = sizeof(buf);
+    HMODULE mod = GetModuleHandleW(drvW);
+    if (!mod) return NULL;
+    if (!RegGetValueW(HKEY_CURRENT_USER, keyW, valueW, RRF_RT_REG_SZ, NULL, buf, &size) &&
+        (buf[0] == 'n' || buf[0] == 'N' || buf[0] == '0' || buf[0] == 'f' || buf[0] == 'F'))
+        return NULL;
+    return (mac_file_panel_func)GetProcAddress(mod, "wine_macdrv_file_panel");
+}
+
+#endif
