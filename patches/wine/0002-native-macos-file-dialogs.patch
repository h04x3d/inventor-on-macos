+/* Native macOS panel (winemac.drv). E_NOTIMPL = not available, use Wine's dialog. */
+static HRESULT show_mac_panel(FileDialogImpl *This, HWND parent)
+{
+    mac_file_panel_func panel_func = get_mac_file_panel();
+    struct mac_file_panel panel = {0};
+    const WCHAR **names = NULL, **specs = NULL;
+    WCHAR *dir = NULL, *name = NULL, *results = NULL, *p;
+    IShellItem *folder = This->psi_setfolder ? This->psi_setfolder : This->psi_defaultfolder;
+    HRESULT hr = E_NOTIMPL;
+    UINT i, count;
+    int ret;
+
+    /* apps that add their own controls get Wine's dialog, which can show them */
+    if (!panel_func || !list_empty(&This->cctrls)) return E_NOTIMPL;
+
+    if (folder) IShellItem_GetDisplayName(folder, SIGDN_FILESYSPATH, &dir);
+    if (This->set_filename)
+    {
+        name = StrDupW(This->set_filename);
+        if ((p = wcsrchr(name, '\\')))
+        {
+            *p = 0;
+            if (!dir) { dir = CoTaskMemAlloc((lstrlenW(name) + 1) * sizeof(WCHAR)); lstrcpyW(dir, name); }
+            memmove(name, p + 1, (lstrlenW(p + 1) + 1) * sizeof(WCHAR));
+        }
+    }
+    if (This->filterspec_count)
+    {
+        names = malloc(This->filterspec_count * sizeof(*names));
+        specs = malloc(This->filterspec_count * sizeof(*specs));
+        for (i = 0; i < This->filterspec_count; i++)
+        {
+            names[i] = This->filterspecs[i].pszName;
+            specs[i] = This->filterspecs[i].pszSpec;
+        }
+    }
+    results = malloc(64 * 1024 * sizeof(WCHAR));
+
+    panel.mode = (This->options & FOS_PICKFOLDERS) ? MAC_FILEPANEL_FOLDER :
+                 This->dlg_type == ITEMDLG_TYPE_SAVE ? MAC_FILEPANEL_SAVE : MAC_FILEPANEL_OPEN;
+    panel.multi = !!(This->options & FOS_ALLOWMULTISELECT);
+    panel.owner = parent;
+    panel.title = This->custom_title;
+    panel.ok_label = This->custom_okbutton;
+    panel.initial_dir = dir;
+    panel.file_name = name;
+    panel.filter_count = This->filterspec_count;
+    panel.filter_names = names;
+    panel.filter_specs = specs;
+    panel.filter_index = This->filetypeindex;
+    panel.results = results;
+    panel.results_size = 64 * 1024;
+
+    while ((ret = panel_func(&panel)) == 1)
+    {
+        LPITEMIDLIST pidls[256];
+        IShellFolder *desktop;
+
+        for (count = 0, p = results; *p && count < ARRAY_SIZE(pidls); p += lstrlenW(p) + 1)
+            if (SUCCEEDED(SHParseDisplayName(p, NULL, &pidls[count], 0, NULL)))
+                count++;
+            else if (This->dlg_type == ITEMDLG_TYPE_SAVE && (pidls[count] = SHSimpleIDListFromPath(p)))
+                count++;   /* new file: doesn't exist yet */
+        if (!count) { hr = E_FAIL; break; }
+
+        if (This->psia_results) { IShellItemArray_Release(This->psia_results); This->psia_results = NULL; }
+        SHGetDesktopFolder(&desktop);
+        hr = SHCreateShellItemArray(NULL, desktop, count, (PCUITEMID_CHILD_ARRAY)pidls, &This->psia_results);
+        IShellFolder_Release(desktop);
+        for (i = 0; i < count; i++) ILFree(pidls[i]);
+        if (FAILED(hr)) break;
+
+        if (This->filterspec_count && panel.filter_index < This->filterspec_count)
+        {
+            This->filetypeindex = panel.filter_index;
+            set_current_filter(This, This->filterspecs[This->filetypeindex].pszSpec);
+        }
+        if (events_OnFileOk(This) == S_OK) { hr = S_OK; break; }
+    }
+    if (ret == 0) hr = HRESULT_FROM_WIN32(ERROR_CANCELLED);
+    if (ret < 0) hr = E_NOTIMPL;
+
+    free(names); free(specs); free(results); LocalFree(name);
+    CoTaskMemFree(dir);
+    return hr;
+}
+
 static HRESULT create_dialog(FileDialogImpl *This, HWND parent)
 {
     ULONG_PTR ctx_cookie = 0;
     INT_PTR res;
+    HRESULT hr;
 
     if (This->dlg_hwnd)
         return E_UNEXPECTED;
 
+    if ((hr = show_mac_panel(This, parent)) != E_NOTIMPL)
+        return hr;
+
     if (!GetCurrentActCtx(&This->user_actctx))
         This->user_actctx = INVALID_HANDLE_VALUE;
 
