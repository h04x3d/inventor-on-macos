+/* Native macOS panel for plain GetOpen/SaveFileNameW calls (no hooks/templates).
+ * Returns 1 chosen, 0 cancelled, -1 use Wine's dialog. */
+static int mac_panel_ofn(OPENFILENAMEW *ofn, BOOL save)
+{
+    mac_file_panel_func panel_func = get_mac_file_panel();
+    struct mac_file_panel panel = {0};
+    const WCHAR *names[64], *specs[64], *f;
+    WCHAR *results, *dir = NULL, *name = NULL, *p, *first;
+    UINT count = 0, len;
+    int ret;
+
+    if (!panel_func || (ofn->Flags & (OFN_ENABLEHOOK | OFN_ENABLETEMPLATE | OFN_ENABLETEMPLATEHANDLE))) return -1;
+    for (f = ofn->lpstrFilter; f && *f && count < ARRAY_SIZE(names); )
+    {
+        names[count] = f; f += lstrlenW(f) + 1;
+        if (!*f) break;
+        specs[count++] = f; f += lstrlenW(f) + 1;
+    }
+    if (ofn->lpstrFile && *ofn->lpstrFile)
+    {
+        name = wcsdup(ofn->lpstrFile);
+        if ((p = wcsrchr(name, '\\')))
+        {
+            *p = 0; dir = wcsdup(name);
+            memmove(name, p + 1, (lstrlenW(p + 1) + 1) * sizeof(WCHAR));
+        }
+    }
+    if (!(results = malloc(64 * 1024 * sizeof(WCHAR)))) return -1;
+
+    panel.mode = save ? MAC_FILEPANEL_SAVE : MAC_FILEPANEL_OPEN;
+    panel.multi = !save && (ofn->Flags & OFN_ALLOWMULTISELECT);
+    panel.owner = ofn->hwndOwner;
+    panel.title = ofn->lpstrTitle;
+    panel.initial_dir = ofn->lpstrInitialDir && *ofn->lpstrInitialDir ? ofn->lpstrInitialDir : dir;
+    panel.file_name = name;
+    panel.filter_count = count;
+    panel.filter_names = names;
+    panel.filter_specs = specs;
+    panel.filter_index = ofn->nFilterIndex ? ofn->nFilterIndex - 1 : 0;
+    panel.results = results;
+    panel.results_size = 64 * 1024;
+
+    ret = panel_func(&panel);
+    if (ret == 1)
+    {
+        UINT n = 0, total;
+        for (p = results; *p; p += lstrlenW(p) + 1) n++;
+        first = results;
+        if (save && ofn->lpstrDefExt && *ofn->lpstrDefExt && !wcschr(wcsrchr(first, '\\') ? wcsrchr(first, '\\') : first, '.'))
+        {
+            lstrcatW(first, L"."); lstrcatW(first, ofn->lpstrDefExt); first[lstrlenW(first) + 1] = 0;
+        }
+        if (n > 1 && (ofn->Flags & OFN_ALLOWMULTISELECT))
+        {
+            /* explorer style: directory\0name1\0name2\0\0 */
+            WCHAR *dst = ofn->lpstrFile;
+            len = wcsrchr(first, '\\') - first;
+            total = len + 2;
+            for (p = results; *p; p += lstrlenW(p) + 1) total += lstrlenW(wcsrchr(p, '\\') + 1) + 1;
+            if (total > ofn->nMaxFile) { COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL); ret = 0; goto done; }
+            memcpy(dst, first, len * sizeof(WCHAR)); dst[len] = 0; dst += len + 1;
+            for (p = results; *p; p += lstrlenW(p) + 1) { lstrcpyW(dst, wcsrchr(p, '\\') + 1); dst += lstrlenW(dst) + 1; }
+            *dst = 0;
+            ofn->nFileOffset = len + 1;
+            ofn->nFileExtension = 0;
+        }
+        else
+        {
+            WCHAR *base = wcsrchr(first, '\\') ? wcsrchr(first, '\\') + 1 : first, *ext = wcsrchr(base, '.');
+            if ((UINT)lstrlenW(first) + 2 > ofn->nMaxFile) { COMDLG32_SetCommDlgExtendedError(FNERR_BUFFERTOOSMALL); ret = 0; goto done; }
+            lstrcpyW(ofn->lpstrFile, first); ofn->lpstrFile[lstrlenW(first) + 1] = 0;
+            ofn->nFileOffset = base - first;
+            ofn->nFileExtension = ext ? ext - first + 1 : 0;
+            if (ofn->lpstrFileTitle && ofn->nMaxFileTitle) lstrcpynW(ofn->lpstrFileTitle, base, ofn->nMaxFileTitle);
+        }
+        ofn->nFilterIndex = panel.filter_index + 1;
+    }
+    else if (ret == 0) COMDLG32_SetCommDlgExtendedError(0);
+done:
+    free(results); free(dir); free(name);
+    return ret;
+}
