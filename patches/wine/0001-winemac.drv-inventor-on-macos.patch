+
+/***********************************************************************
+ *              DXMT variants of the metal view functions
+ *
+ * newMetalViewWithDevice: returns the content view's single cached metal view,
+ * but DXMT creates a "new" view and releases the old one on every swapchain
+ * resize - which removed and freed the shared view (blank 3D view after a
+ * resize). These keep one reference per DXMT request and leave the view in place.
+ */
+WineMetalView *macdrv_dxmt_create_metal_view(WineContentView *view, id<MTLDevice> device)
+{
+    __block WineMetalView *metalView;
+
+    OnMainThread(^{
+        metalView = [view newMetalViewWithDevice:device];
+        [metalView retain];
+    });
+
+    return metalView;
+}
+
+void macdrv_dxmt_release_metal_view(WineMetalView *view)
+{
+    OnMainThread(^{
+        [view release];
+    });
+}
diff --git a/b/dlls/winemac.drv/dxmt.c b/dlls/winemac.drv/dxmt.c
new file mode 100644
index 0000000..9d046be
--- /dev/null
+++ b/dlls/winemac.drv/dxmt.c
@@ -0,0 +1,163 @@
+/*
+ * Export for DXMT (Direct3D 11 -> Metal): "macdrv_functions".
+ *
+ * DXMT's winemetal.so dlsym()s this table and reads a macdrv_win_data with the
+ * old layout { hwnd, cocoa_window, cocoa_view, client_cocoa_view }. Wine 11's
+ * macdrv_win_data differs, so get_win_data here returns a shim with that layout
+ * whose client view is a Wine client surface's view (as used by Wine's own
+ * Vulkan/OpenGL), which also works for child windows and follows resizes.
+ */
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <pthread.h>
+#include "macdrv.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+struct dxmt_win_data
+{
+    HWND hwnd;
+    void *cocoa_window;
+    void *cocoa_view;
+    void *client_cocoa_view;
+};
+
+struct dxmt_surface_entry { HWND hwnd; struct macdrv_client_surface *surface; };
+static struct dxmt_surface_entry dxmt_surfaces[64];
+static pthread_mutex_t dxmt_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct macdrv_client_surface *dxmt_get_surface(HWND hwnd)
+{
+    struct macdrv_client_surface *surface = NULL;
+    struct macdrv_win_data *data;
+    struct client_surface *client;
+    int i, free_slot = -1;
+
+    pthread_mutex_lock(&dxmt_lock);
+    for (i = 0; i < 64; i++)
+    {
+        if (dxmt_surfaces[i].hwnd == hwnd) { surface = dxmt_surfaces[i].surface; break; }
+        if (!dxmt_surfaces[i].hwnd && free_slot < 0) free_slot = i;
+    }
+    /* reuse only while it is still the window's current client view */
+    if (surface && (data = get_win_data(hwnd)))
+    {
+        if (data->client_view != surface->cocoa_view) surface = NULL;
+        release_win_data(data);
+    }
+    if (!surface)
+    {
+        if (i < 64) dxmt_surfaces[i].hwnd = NULL;
+        if ((client = macdrv_CreateClientSurface(hwnd, 0, FALSE)))
+        {
+            surface = impl_from_client_surface(client);
+            if (i == 64) i = free_slot >= 0 ? free_slot : 0;
+            dxmt_surfaces[i].hwnd = hwnd;
+            dxmt_surfaces[i].surface = surface;
+        }
+    }
+    pthread_mutex_unlock(&dxmt_lock);
+    return surface;
+}
+
+
+/* Called from macdrv_WindowPosChanged: win32u only keeps client surfaces it
+ * "uses" in sync, so follow moves/resizes/visibility of DXMT's views here. */
+void dxmt_window_pos_changed(HWND hwnd)
+{
+    struct macdrv_client_surface *todo[64];
+    HWND todo_hwnd[64];
+    int i, n = 0;
+
+    pthread_mutex_lock(&dxmt_lock);
+    for (i = 0; i < 64; i++)
+    {
+        HWND h = dxmt_surfaces[i].hwnd;
+        if (!h) continue;
+        if (!NtUserIsWindow(h)) { dxmt_surfaces[i].hwnd = NULL; continue; }
+        while (h && h != hwnd) h = NtUserGetAncestor(h, GA_PARENT);
+        if (!h) continue;
+        todo[n] = dxmt_surfaces[i].surface;
+        todo_hwnd[n++] = dxmt_surfaces[i].hwnd;
+    }
+    pthread_mutex_unlock(&dxmt_lock);
+
+    for (i = 0; i < n; i++)
+    {
+        struct macdrv_client_surface *surface = todo[i];
+        BOOL visible;
+        if (!surface->client.hwnd || !surface->cocoa_view) continue;
+        visible = NtUserIsWindowVisible(todo_hwnd[i]);
+        if (visible) client_surface_present(&surface->client); /* refreshes rects -> view frame */
+        if (surface->client.hwnd) macdrv_set_view_hidden(surface->cocoa_view, !visible);
+        if (getenv("DXMT_SHIM_DEBUG"))
+            fprintf(stderr, "dxmt-shim: update %p (from %p) visible %d rect %s\n", todo_hwnd[i], hwnd, visible,
+                    wine_dbgstr_rect(&surface->client.monitor_rect));
+    }
+}
+
+static struct macdrv_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_client_surface *surface = dxmt_get_surface(hwnd);
+    struct dxmt_win_data *shim;
+    struct macdrv_win_data *data;
+
+    if (!surface) return NULL;
+    client_surface_present(&surface->client);
+    if (!(shim = calloc(1, sizeof(*shim)))) return NULL;
+    shim->hwnd = hwnd;
+    shim->cocoa_view = shim->client_cocoa_view = surface->cocoa_view;
+    if ((data = get_win_data(hwnd)))
+    {
+        shim->cocoa_window = data->cocoa_window;
+        release_win_data(data);
+    }
+    if (getenv("DXMT_SHIM_DEBUG"))
+        fprintf(stderr, "dxmt-shim: hwnd %p toplevel %p -> view %p window %p rect %s\n", hwnd, surface->client.toplevel,
+                shim->client_cocoa_view, shim->cocoa_window, wine_dbgstr_rect(&surface->client.monitor_rect));
+    TRACE("hwnd %p -> view %p\n", hwnd, shim->client_cocoa_view);
+    return (struct macdrv_win_data *)shim;
+}
+
+static void dxmt_release_win_data(struct macdrv_win_data *data)
+{
+    free(data);
+}
+
+static void *dxmt_get_cocoa_window(HWND hwnd, BOOL require_on_screen)
+{
+    return macdrv_get_cocoa_window(hwnd, require_on_screen);
+}
+
+struct macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct macdrv_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct macdrv_win_data *data);
+    void *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    void *(*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(void *d);
+    void *(*macdrv_view_create_metal_view)(void *v, void *d);
+    void *(*macdrv_view_get_metal_layer)(void *v);
+    void (*macdrv_view_release_metal_view)(void *v);
+    void (*on_main_thread)(void *b);
+};
+
+__attribute__((visibility("default"))) struct macdrv_functions_t macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    dxmt_get_cocoa_window,
+    (void *)macdrv_create_metal_device,
+    (void *)macdrv_release_metal_device,
+    (void *)macdrv_dxmt_create_metal_view,
+    (void *)macdrv_view_get_metal_layer,
+    (void *)macdrv_dxmt_release_metal_view,
+    NULL,
+};
