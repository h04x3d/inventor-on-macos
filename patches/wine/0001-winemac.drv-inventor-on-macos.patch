diff --git a/b/dlls/winemac.drv/cocoa_filepanel.m b/dlls/winemac.drv/cocoa_filepanel.m
new file mode 100644
index 0000000..b526cac
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_filepanel.m
@@ -0,0 +1,149 @@
+/*
+ * Native NSOpenPanel / NSSavePanel for Wine's file dialogs.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+#import <AppKit/AppKit.h>
+#include "macdrv_cocoa.h"
+#import "cocoa_app.h"
+#import "cocoa_window.h"
+
+/* filters: lines "name\tspec\n"; spec like "*.ipt;*.iam" */
+static NSArray<NSString*>* extensions_for_spec(NSString* spec)
+{
+    NSMutableArray* exts = [NSMutableArray array];
+    for (NSString* part in [spec componentsSeparatedByString:@";"])
+    {
+        NSString* p = [part stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
+        if ([p isEqualToString:@"*"] || [p isEqualToString:@"*.*"]) return nil;   /* everything */
+        if ([p hasPrefix:@"*."]) p = [p substringFromIndex:2];
+        if ([p length] && [p rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"*?"]].location == NSNotFound)
+            [exts addObject:p];
+    }
+    return [exts count] ? exts : nil;
+}
+
+@interface WineFilePanelFilter : NSObject
+@property (assign) NSSavePanel* panel;
+@property (retain) NSArray* specs;
+- (void) filterChanged:(NSPopUpButton*)sender;
+@end
+
+@implementation WineFilePanelFilter
+- (void) apply:(NSInteger)index
+{
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    if (index >= 0 && index < (NSInteger)[self.specs count])
+        self.panel.allowedFileTypes = extensions_for_spec(self.specs[index]);
+    else
+        self.panel.allowedFileTypes = nil;
+#pragma clang diagnostic pop
+}
+- (void) filterChanged:(NSPopUpButton*)sender { [self apply:[sender indexOfSelectedItem]]; }
+- (void) dealloc { [_specs release]; [super dealloc]; }
+@end
+
+int macdrv_run_file_panel(WineWindow* owner, int mode, int multi, const char* title, const char* ok_label,
+                          const char* dir, const char* name, const char* filters, int* filter_index,
+                          char* out, int out_size)
+{
+    __block int ret = 0;
+    __block NSString* result = nil;
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+
+    OnMainThreadAsync(^{
+        NSSavePanel* panel;
+        NSOpenPanel* open = nil;
+        WineFilePanelFilter* filter = nil;
+        NSPopUpButton* popup = nil;
+        NSMutableArray* names = [NSMutableArray array];
+        NSMutableArray* specs = [NSMutableArray array];
+
+        if (mode == 1) panel = [NSSavePanel savePanel];
+        else panel = open = [NSOpenPanel openPanel];
+
+        if (open)
+        {
+            open.canChooseFiles = (mode != 2);
+            open.canChooseDirectories = (mode == 2);
+            open.allowsMultipleSelection = multi && mode != 2;
+            open.resolvesAliases = YES;
+        }
+        panel.canCreateDirectories = YES;
+        panel.showsHiddenFiles = NO;
+        if (title && *title)
+        {
+            panel.title = @(title);
+            if (mode == 2) panel.message = @(title);   /* folder pickers pass an instruction text */
+        }
+        if (ok_label && *ok_label) panel.prompt = [@(ok_label) stringByReplacingOccurrencesOfString:@"&" withString:@""];
+        if (dir && *dir) panel.directoryURL = [NSURL fileURLWithPath:@(dir) isDirectory:YES];
+
+        if (mode != 2 && filters && *filters)
+        {
+            for (NSString* line in [@(filters) componentsSeparatedByString:@"\n"])
+            {
+                NSArray* f = [line componentsSeparatedByString:@"\t"];
+                if ([f count] != 2) continue;
+                [names addObject:f[0]]; [specs addObject:f[1]];
+            }
+        }
+        if ([specs count])
+        {
+            filter = [[[WineFilePanelFilter alloc] init] autorelease];
+            filter.panel = panel; filter.specs = specs;
+            if ([specs count] > 1)
+            {
+                NSView* view = [[[NSView alloc] initWithFrame:NSMakeRect(0, 0, 420, 44)] autorelease];
+                NSTextField* label = [NSTextField labelWithString:@"Format:"];
+                popup = [[[NSPopUpButton alloc] initWithFrame:NSMakeRect(80, 10, 320, 26) pullsDown:NO] autorelease];
+                [popup addItemsWithTitles:names];
+                [popup setTarget:filter]; [popup setAction:@selector(filterChanged:)];
+                [label setFrame:NSMakeRect(10, 14, 66, 18)]; [label setAlignment:NSTextAlignmentRight];
+                [view addSubview:label]; [view addSubview:popup];
+                panel.accessoryView = view;
+                if (open) open.accessoryViewDisclosed = YES;
+            }
+            NSInteger idx = (*filter_index >= 0 && *filter_index < (int)[specs count]) ? *filter_index : 0;
+            [popup selectItemAtIndex:idx];
+            [filter apply:idx];
+        }
+        /* after the file types, so macOS doesn't append the extension a second time */
+        if (mode == 1 && name && *name) panel.nameFieldStringValue = @(name);
+
+        void (^finish)(NSModalResponse) = ^(NSModalResponse response) {
+            if (response == NSModalResponseOK)
+            {
+                NSMutableArray* paths = [NSMutableArray array];
+                if (open) for (NSURL* url in open.URLs) [paths addObject:url.path];
+                else if (panel.URL) [paths addObject:panel.URL.path];
+                result = [[paths componentsJoinedByString:@"\n"] retain];
+                if (popup) *filter_index = (int)[popup indexOfSelectedItem];
+                ret = 1;
+            }
+            [filter retain]; [filter autorelease];   /* keep the popup target alive until here */
+            dispatch_semaphore_signal(done);
+        };
+
+        [NSApp activateIgnoringOtherApps:YES];
+        if (owner && [owner isVisible] && ![owner attachedSheet])
+            [panel beginSheetModalForWindow:owner completionHandler:finish];
+        else
+            finish([panel runModal]);
+    });
+
+    dispatch_semaphore_wait(done, DISPATCH_TIME_FOREVER);
+    dispatch_release(done);
+    if (ret == 1)
+    {
+        const char* utf8 = [result UTF8String];
+        if ((int)strlen(utf8) + 1 > out_size) ret = -2;
+        else strcpy(out, utf8);
+        [result release];
+    }
+    return ret;
+}
